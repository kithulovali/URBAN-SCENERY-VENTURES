# Copy to .env for local development. Never commit real secrets.

# Runtime and database
ENVIRONMENT=development
DATABASE_URL=sqlite:///./urban_ventures.db

# Security: replace with a long random value; required when ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated frontend origins; do not use * with credentialed requests
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional Gemini integration
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
